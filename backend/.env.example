# Copy this file to .env and fill with real values
# Either set DATABASE_URL directly, or set the components below

# Example DATABASE_URL:
# DATABASE_URL=postgresql://username:password@localhost:5432/bioscan_db

# Or provide components:
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bioscan_db

# Optional: set a full URL instead
# DATABASE_URL=
